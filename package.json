{
    "name": "aelith",
    "description": "",
    "keywords": [],
    "private": true,
    "author": "dragoncoder047",
    "main": "src/main.ts",
    "scripts": {
        "build:data": "python3 scripts/build_datapack.py",
        "build:js": "bun scripts/build.ts",
        "build:clean": "rm -rf build/ && mkdir build",
        "build": "bun run --sequential build:clean build:js build:data",
        "dev:build": "bun --bun nodemon -e yaml,json,png,woff,otf,ttf,txt,glsl,wav,ogg,mp3,js,ts,bk -i build --exec \"bun run build\"",
        "dev:serve": "python3 -m http.server",
        "build:minified": "bun rin build:clean && bun run build --minify",
        "dev": "bun run --parallel \"dev:*\"",
        "lint": "bun tsc && python3 scripts/lint_strings.py",
        "linecount": "IFS=$'\\n'; for f in `git ls-files -- '[^.]**.*'`; do enca \"$f\" -L none | grep -ie \"UTF-8\\|ASCII\" -q && echo \"$f\" || true; done | xargs wc -l",
        "showip": "ifconfig | grep \"inet \" | grep -Fv 127.0.0.1 | awk '{print $2}'",
        "test": "bun test --todo",
        "test:watch": "bun run test --watch"
    },
    "license": "AGPL-3.0-only",
    "devDependencies": {
        "@types/bun": "^1.3.9",
        "@types/semver": "^7.7.1",
        "esbuild-plugin-glsl": "^1.4.1",
        "nodemon": "^3.1.10",
        "stacktrace-js": "^2.0.2",
        "typescript": "^5.6.2"
    },
    "dependencies": {
        "@bridge-editor/molang": "^2.0.2",
        "@michaelhomer/jqjs": "^1.6.0",
        "@r47onfire/kaplay-gamepad-haptics": "^0.1.0",
        "brigadier-ts-lite": "^1.0.2",
        "kaplay": "github:dragoncoder047/kaplay#25a76d0647adffc0d87273fd78f64c747efec0ea",
        "kaplay-lighting": "github:dragoncoder047/kaplay-lighting#943a1f2e5b0f7ad5915371087d5d0928223ef35c",
        "lib0": "^0.2.117",
        "lifeweb": "github:speedydelete/lifeweb#21c58b4570b6ae2a40a89e2463492bffe46dffa7",
        "mutative-yjs": "^0.2.1",
        "semver": "^7.7.4",
        "y-indexeddb": "^9.0.12",
        "y-webrtc": "^10.3.0",
        "yjs": "^13.6.29",
        "zzfx": "^1.3.0"
    },
    "type": "module"
}